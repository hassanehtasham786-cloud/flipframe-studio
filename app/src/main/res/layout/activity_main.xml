<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:background="@color/panel">

        <Button
            android:id="@+id/btn_project"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_button"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/text_main"
            android:textAllCaps="false"
            android:text="@string/save_project" />

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="@color/text_main"
            android:textSize="15sp"
            android:text="My Animation" />

        <TextView
            android:id="@+id/save_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_dim"
            android:textSize="12sp"
            android:text="Saved" />
    </LinearLayout>

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp"
        android:textColor="@color/text_dim"
        android:textSize="12sp"
        android:autoLink="none"
        android:maxLines="2"
        android:text="Ready" />

    <FrameLayout
        android:id="@+id/canvas_host"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/toolbar_bg">

        <com.flipframe.studio.draw.DrawingView
            android:id="@+id/canvas"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:background="@color/toolbar_bg">

        <LinearLayout
            android:id="@+id/toolbar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="6dp">

            <Button
                android:id="@+id/btn_color"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_button"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/text_main"
                android:textAllCaps="false"
                android:text="Color" />

            <Button
                android:id="@+id/btn_brush"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_button"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/text_main"
                android:textAllCaps="false"
                android:text="Brush" />

            <Button
                android:id="@+id/btn_eraser"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_button"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/text_main"
                android:textAllCaps="false"
                android:text="Eraser" />

            <Button
                android:id="@+id/btn_undo"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_button"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/text_main"
                android:textAllCaps="false"
                android:text="@string/undo" />

            <Button
                android:id="@+id/btn_redo"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_button"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/text_main"
                android:textAllCaps="false"
                android:text="@string/redo" />

            <Button
                android:id="@+id/btn_clear"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_button"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="@color/danger"
                android:textAllCaps="false"
                android:text="Clear" />
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/timeline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="6dp"
        android:background="@color/panel">

        <Button
            android:id="@+id/btn_play"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="56dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_button"
            android:textColor="@color/text_main"
            android:textAllCaps="false"
            android:text="Play" />

        <Button
            android:id="@+id/btn_prev"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_button"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/text_main"
            android:textAllCaps="false"
            android:text="Prev" />

        <TextView
            android:id="@+id/frame_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:minWidth="64dp"
            android:gravity="center"
            android:textColor="@color/text_main"
            android:textSize="13sp"
            android:text="1 / 1" />

        <Button
            android:id="@+id/btn_next"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_button"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/text_main"
            android:textAllCaps="false"
            android:text="Next" />

        <Button
            android:id="@+id/btn_duplicate"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_button"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/text_main"
            android:textAllCaps="false"
            android:text="Dup" />

        <Button
            android:id="@+id/btn_insert"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_button"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/text_main"
            android:textAllCaps="false"
            android:text="Add" />

        <Button
            android:id="@+id/btn_delete"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_button"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/danger"
            android:textAllCaps="false"
            android:text="Del" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingBottom="8dp"
        android:background="@color/panel">

        <Button
            android:id="@+id/btn_flipscript"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_button"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/accent"
            android:textAllCaps="false"
            android:text="@string/flipscript" />

        <Button
            android:id="@+id/btn_export_png"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_button"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/text_main"
            android:textAllCaps="false"
            android:text="@string/export_frame_png" />

        <Button
            android:id="@+id/btn_fps"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_button"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textColor="@color/text_main"
            android:textAllCaps="false"
            android:text="FPS 8" />
    </LinearLayout>
</LinearLayout>
